{
    "name": "bendamqui/php-package-template",
    "type": "library",
    "license": "MIT",
    "description": "Boilerplate for PHP packages",
    "authors": [
        {
            "name": "Benoît Michaud",
            "email": "bendamqui@icloud.com"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.2.7"
    },
    "autoload": {
        "psr-4": {
            "Package\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
